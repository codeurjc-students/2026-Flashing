# Solo desarrollo local. No reutilizar estas credenciales en un despliegue.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=flashing
DB_USERNAME=flashing
DB_PASSWORD=flashing_local
MYSQL_ROOT_PASSWORD=root_local
# Optional locally: if absent, a random key is generated at startup (log in again after restarting).
# For deployment, set a private random JWT_SECRET of at least 32 bytes and keep it stable.
